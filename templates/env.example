# ============================================
# BulkDeal Analyzer - Environment Variables
# ============================================
# Copy this file to .env.development and fill in your values
# NEVER commit .env files to git

# ============================================
# Database (Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# Authentication (Supabase Auth)
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# AI Services
# ============================================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: Vercel AI Gateway
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# ============================================
# Payment Processing (Stripe)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Error Tracking (Sentry - Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# ============================================
# Feature Flags (Optional)
# ============================================
FEATURE_FLAG_KEY=your_feature_flag_key

# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=development
APP_NAME=BulkDeal Analyzer
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================
# Frontend (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ============================================
# Email Configuration (Development)
# ============================================
# For development, use Mailcatcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bulkdealanalyzer.com

# ============================================
# NSE Data Source
# ============================================
NSE_BULK_DEALS_URL=https://www.nseindia.com/reports/bulk-deals

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# Security
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# File Upload
# ============================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,xlsx

# ============================================
# Localization
# ============================================
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi


